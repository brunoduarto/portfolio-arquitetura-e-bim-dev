---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const phone = '5531987760114';
const message = encodeURIComponent('Oi! Gostei do que vi no site e tenho interesse em começar um projeto com você.');
const whatsappUrl = `https://wa.me/${phone}?text=${message}`;
---

<BaseLayout title="Contato" description="Entre em contato para projetos de arquitetura, design de interiores e reformas em Belo Horizonte.">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <SectionHeading
      title="Vamos conversar?"
      subtitle="Conte-me sobre o seu projeto"
    />

    <div class="grid md:grid-cols-2 gap-12 mt-10">
      {/* Left — WhatsApp + contact links */}
      <div>
        <p class="text-lg text-ink-600 leading-relaxed mb-8">
          Tem um projeto em mente ou quer entender melhor como posso ajudar?
          Entre em contato e vamos conversar sem compromisso.
        </p>

        {/* WhatsApp CTA */}
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-contact
          class="flex items-center gap-4 bg-[#25D366] text-white p-5 hover:bg-[#20BD5A] transition-all group shadow-md hover:shadow-lg"
        >
          <div class="w-12 h-12 bg-white/20 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <span class="text-sm opacity-80">Chamar no</span>
            <p class="text-lg font-medium">WhatsApp</p>
          </div>
        </a>

        {/* Other links */}
        <div class="mt-6 space-y-3">
          <a
            href="mailto:contato@bruno.arq.br"
            class="flex items-center gap-3 bg-warm-100 border border-warm-200 p-4 hover:border-warm-400 hover:shadow-black/40 hover:shadow-md transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-warm-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <span class="text-xs text-ink-400">Email</span>
              <p class="text-sm text-ink-800">contato@bruno.arq.br</p>
            </div>
          </a>
          <a
            href="https://www.linkedin.com/in/bruno-duarte-deoliveira/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-warm-100 border border-warm-200 p-4 hover:border-warm-400 hover:shadow-black/40 hover:shadow-md transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-warm-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z" />
            </svg>
            <div>
              <span class="text-xs text-ink-400">LinkedIn</span>
              <p class="text-sm text-ink-800">Bruno Duarte</p>
            </div>
          </a>
        </div>

        {/* Quiz link */}
        <div class="band mt-8 p-6 border border-ink-800 text-white">
          <p class="text-warm-300 text-sm mb-2">Quer adiantar o processo?</p>
          <a href="/quiz" class="text-lg font-display text-warm-50 hover:text-warm-300 transition-colors">
            Preencher briefing de projeto &rarr;
          </a>
        </div>
      </div>

      {/* Right — Contact form */}
      <div>
        <h3 class="font-display text-xl text-ink-950 mb-6">Enviar mensagem</h3>
        <form id="contact-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm text-ink-600 mb-1">Nome</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-warm-100 border border-warm-200 text-ink-800 text-sm focus:outline-none focus:border-warm-500 transition-colors"
              placeholder="Seu nome"
            />
          </div>
          <div>
            <label for="email" class="block text-sm text-ink-600 mb-1">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-warm-100 border border-warm-200 text-ink-800 text-sm focus:outline-none focus:border-warm-500 transition-colors"
              placeholder="seu@email.com"
            />
          </div>
          <div>
            <label for="project-type" class="block text-sm text-ink-600 mb-1">Tipo de projeto</label>
            <select
              id="project-type"
              name="project-type"
              class="w-full px-4 py-3 bg-warm-100 border border-warm-200 text-ink-800 text-sm focus:outline-none focus:border-warm-500 transition-colors"
            >
              <option value="">Selecione...</option>
              <option value="residencial">Projeto Residencial</option>
              <option value="comercial">Projeto Comercial</option>
              <option value="interiores">Design de Interiores</option>
              <option value="reforma">Reforma</option>
              <option value="outro">Outro</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm text-ink-600 mb-1">Mensagem</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              class="w-full px-4 py-3 bg-warm-100 border border-warm-200 text-ink-800 text-sm focus:outline-none focus:border-warm-500 transition-colors resize-none"
              placeholder="Conte um pouco sobre o que você precisa..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full px-6 py-3 bg-warm-800 text-white text-sm font-medium hover:bg-warm-500 transition-colors"
          >
            Enviar
          </button>
          <p class="text-xs text-ink-400 text-center">
            O formulário ainda não está conectado a um backend. Por enquanto, use o WhatsApp ao lado.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
