---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import GalleryProjectLayout from '../../layouts/GalleryProjectLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  // "Próximo projeto" follows the same order as the projects page, wrapping around.
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const isGallery = project.data.category !== 'scripting';
---

{isGallery ? (
  <GalleryProjectLayout project={project} next={next}>
    <Content />
  </GalleryProjectLayout>
) : (
  <ProjectLayout project={project}>
    <Content />
  </ProjectLayout>
)}
