---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Artigos sobre arquitetura, reformas, design de interiores e dicas para quem quer construir ou reformar em BH."
>
  <section class="max-w-7xl mx-auto px-5 md:px-10 pt-16 md:pt-24 pb-24 md:pb-32">
    <header class="grid lg:grid-cols-12 gap-8 items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="eyebrow">Notas de projeto</p>
        <h1 class="mt-5 font-display text-5xl md:text-7xl leading-[1.02] text-ink-950">Blog</h1>
      </div>
      <p class="lg:col-span-4 lg:col-start-9 text-ink-600 leading-relaxed">
        Dicas e artigos sobre arquitetura, reformas e interiores — para quem vai construir ou reformar.
      </p>
    </header>

    <div class="mt-14 md:mt-20 pt-14 md:pt-20 border-t border-warm-300 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {posts.map((post, i) => (
        <div data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            date={post.data.pubDate.toISOString()}
            coverImage={post.data.coverImage}
            category={post.data.category}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
