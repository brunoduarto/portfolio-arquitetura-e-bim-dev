---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, category, technologies, pubDate, repoUrl, coverImage } = project.data;

const categoryLabels: Record<string, string> = {
  'scripting':           'Automação BIM',
  '3d-modeling':         '3D Modeling',
  'executive-projects':  'Proj. Executivo',
  '3d-renders':          '3D Render',
  'general-projects':    'Geral',
};
const categoryLabel = categoryLabels[category] ?? category.replace(/-/g, ' ');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Bruno', url: 'https://bruno.arq.br' },
  ...(repoUrl ? { codeRepository: repoUrl } : {}),
};
---

<BaseLayout title={title} description={description} ogType="article" ogImage={coverImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="max-w-3xl mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-24">
    <header class="mb-12 border-b border-warm-300 pb-10">
      <a href="/projects" class="link-line text-ink-500">&larr; Projetos</a>
      <a href={`/projects?filter=${category}`} class="eyebrow block mt-12 hover:text-warm-700 transition-colors">
        {categoryLabel}
      </a>
      <h1 class="mt-5 font-display text-5xl md:text-6xl leading-[1.05] text-ink-950">
        {title}
      </h1>
      <p class="mt-6 text-ink-600 text-lg leading-relaxed">{description}</p>
      {technologies && technologies.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {technologies.map((tech) => <TagBadge label={tech} />)}
        </div>
      )}
      <div class="flex items-center gap-4 mt-6 text-sm text-ink-400">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long' })}
        </time>
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-warm-600 hover:text-warm-700 underline"
          >
            Repositório
          </a>
        )}
      </div>
    </header>
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
