---
// Project page for visual projects (renders, interiors, executive drawings).
// Order: title + facts → cover → O contexto / A atuação / O resultado → gallery → next project.
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const {
  title, description, pubDate, images, coverImage,
  type, scope, location, technologies,
  context, approach, result,
} = project.data;

const imgs = images ?? [];
const cover = coverImage ?? imgs[0]?.src;
const coverIndex = cover ? imgs.findIndex((img) => img.src === cover) : -1;
const kicker = [type, scope, location].filter(Boolean).join(' · ');
const year = pubDate.getFullYear();

const facts = [
  { label: 'Ano', value: String(year) },
  { label: 'Tipo', value: type },
  { label: 'Escopo', value: scope },
  { label: 'Local', value: location },
  { label: 'Ferramentas', value: technologies?.join(', ') },
].filter((f) => f.value);

// Blank lines in the frontmatter text become separate paragraphs.
const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const sections = [
  { title: 'O contexto', text: context },
  { title: 'A atuação', text: approach },
  { title: 'O resultado', text: result },
].filter((s): s is { title: string; text: string } => Boolean(s.text));
const hasBody = Boolean(project.body?.trim());

// Gallery rhythm: one wide image, then a pair, repeated.
const tile = (i: number) =>
  i % 3 === 0
    ? { span: 'md:col-span-2', aspect: 'aspect-[4/3] md:aspect-[16/9]' }
    : { span: '', aspect: 'aspect-[4/3]' };

const nextImage = next ? next.data.coverImage ?? next.data.images?.[0]?.src : undefined;
const nextKicker = next ? [next.data.type, next.data.scope].filter(Boolean).join(' · ') : '';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Bruno Duarte de Oliveira', url: 'https://bruno.arq.br' },
  ...(cover ? { image: new URL(cover, 'https://bruno.arq.br').toString() } : {}),
};
---

<BaseLayout title={title} description={description} ogType="article" ogImage={cover}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article>
    {/* ───────────── Title and facts ───────────── */}
    <header class="max-w-7xl mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-12 md:pb-16">
      <a href="/projects" class="link-line text-ink-500">&larr; Projetos</a>

      <div class="mt-12 md:mt-16 grid lg:grid-cols-12 gap-y-12 gap-x-8">
        <div class="lg:col-span-8" data-reveal>
          {kicker && <p class="eyebrow">{kicker}</p>}
          <h1 class="mt-5 font-display text-5xl md:text-7xl leading-[1.02] text-ink-950">{title}</h1>
          <p class="mt-8 text-lg md:text-xl leading-relaxed text-ink-600 max-w-2xl">{description}</p>
        </div>

        {facts.length > 0 && (
          <dl class="lg:col-span-3 lg:col-start-10 self-end border-t border-warm-300" data-reveal style="--reveal-delay:120ms">
            {facts.map((f) => (
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4 border-b border-warm-300">
                <dt class="eyebrow pt-0.5">{f.label}</dt>
                <dd class="text-ink-800">{f.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    {/* ───────────── Cover ───────────── */}
    {cover && (
      <div class="max-w-7xl mx-auto px-5 md:px-10" data-reveal>
        {coverIndex >= 0 ? (
          <button
            type="button"
            class="gallery-thumb block w-full img-zoom bg-warm-200 aspect-[4/3] md:aspect-[16/9] cursor-zoom-in"
            data-index={String(coverIndex)}
            aria-label="Ampliar imagem de capa"
          >
            <img src={cover} alt={title} class="w-full h-full object-cover" loading="eager" decoding="async" />
          </button>
        ) : (
          <div class="bg-warm-200 aspect-[4/3] md:aspect-[16/9] overflow-hidden">
            <img src={cover} alt={title} class="w-full h-full object-cover" loading="eager" decoding="async" />
          </div>
        )}
      </div>
    )}

    {/* ───────────── Story ───────────── */}
    {(sections.length > 0 || hasBody) && (
      <section class="max-w-7xl mx-auto px-5 md:px-10 py-20 md:py-32">
        {sections.length > 0 && (
          <ol class="border-t border-warm-300">
            {sections.map((s, i) => (
              <li class="grid lg:grid-cols-12 gap-x-8 gap-y-5 py-10 md:py-14 border-b border-warm-300" data-reveal>
                <div class="lg:col-span-4 flex items-baseline gap-4">
                  <span class="index-num text-xl md:text-2xl">{String(i + 1).padStart(2, '0')}</span>
                  <h2 class="font-display text-3xl md:text-4xl text-ink-950">{s.title}</h2>
                </div>
                <div class="lg:col-span-7 lg:col-start-6 space-y-5 text-ink-700 leading-relaxed text-[1.05rem]">
                  {paragraphs(s.text).map((p) => <p>{p}</p>)}
                </div>
              </li>
            ))}
          </ol>
        )}

        {hasBody && (
          <div class:list={['grid lg:grid-cols-12 gap-x-8 gap-y-5', sections.length > 0 && 'mt-16 md:mt-20']} data-reveal>
            <p class="eyebrow lg:col-span-4">{sections.length > 0 ? 'Notas' : 'Sobre o projeto'}</p>
            <div class="lg:col-span-7 lg:col-start-6 prose prose-lg max-w-none">
              <slot />
            </div>
          </div>
        )}
      </section>
    )}

    {/* ───────────── Gallery ───────────── */}
    {imgs.length > 0 && (
      <section class:list={['max-w-7xl mx-auto px-5 md:px-10 pb-20 md:pb-32', !(sections.length > 0 || hasBody) && 'pt-20 md:pt-32']}>
        <div class="flex items-baseline justify-between gap-6 mb-10 md:mb-14" data-reveal>
          <h2 class="font-display text-4xl md:text-5xl text-ink-950">Galeria</h2>
          <span class="index-num text-lg">{String(imgs.length).padStart(2, '0')} imagens</span>
        </div>

        <div class="grid md:grid-cols-2 gap-4 md:gap-6">
          {imgs.map((img, i) => (
            <figure class={tile(i).span} data-reveal>
              <button
                type="button"
                class:list={['gallery-thumb block w-full img-zoom bg-warm-200 cursor-zoom-in', tile(i).aspect]}
                data-index={String(i)}
                aria-label={img.caption ? `Ampliar: ${img.caption}` : `Ampliar imagem ${i + 1}`}
              >
                <img src={img.src} alt={img.caption ?? ''} class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </button>
              {img.caption && (
                <figcaption class="mt-3 flex gap-3 text-sm text-ink-500">
                  <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                  {img.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>

  {/* ───────────── Next project ───────────── */}
  {next && (
    <section class="bg-warm-100">
      <a href={`/projects/${next.id}`} class="group max-w-7xl mx-auto px-5 md:px-10 py-16 md:py-24 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-6">
          <p class="eyebrow">Próximo projeto</p>
          <p class="mt-5 font-display text-4xl md:text-6xl leading-[1.05] text-ink-950 group-hover:text-warm-700 transition-colors">
            {next.data.title}
          </p>
          {nextKicker && <p class="mt-5 text-ink-500">{nextKicker}</p>}
          <span class="link-line mt-8">Ver projeto &rarr;</span>
        </div>
        {nextImage && (
          <div class="md:col-span-5 md:col-start-8 img-zoom bg-warm-200 aspect-[4/3]">
            <img src={nextImage} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
        )}
      </a>
    </section>
  )}

  {/* ───────────── Lightbox ───────────── */}
  {imgs.length > 0 && (
    <dialog id="lightbox" class="lightbox" aria-label="Galeria de imagens">
      <div class="lb-frame">
        <div class="lb-top">
          <span id="lb-counter" class="lb-counter"></span>
          <button id="lb-close" type="button" class="lb-btn" aria-label="Fechar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" class="w-6 h-6"><path d="M5 5l14 14M19 5L5 19" /></svg>
          </button>
        </div>
        <div class="lb-stage">
          <button id="lb-prev" type="button" class="lb-btn lb-arrow" aria-label="Imagem anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" class="w-7 h-7"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <img id="lb-img" src="" alt="" class="lb-img" />
          <button id="lb-next" type="button" class="lb-btn lb-arrow" aria-label="Próxima imagem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" class="w-7 h-7"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <p id="lb-caption" class="lb-caption"></p>
      </div>
    </dialog>
  )}
</BaseLayout>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-warm-50);
    color: var(--color-ink-950);
  }
  .lightbox::backdrop {
    background: var(--color-warm-50);
  }
  .lb-frame {
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1rem 1.25rem 1.5rem;
  }
  .lb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .lb-counter {
    font-variant-numeric: tabular-nums;
    color: var(--color-warm-700);
  }
  .lb-stage {
    position: relative;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .lb-btn {
    padding: 0.5rem;
    color: var(--color-ink-600);
    transition: color 0.2s;
    cursor: pointer;
  }
  .lb-btn:hover {
    color: var(--color-ink-950);
  }
  .lb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--color-warm-50) 60%, transparent);
  }
  #lb-prev { left: 0; }
  #lb-next { right: 0; }
  .lb-caption {
    min-height: 1.5rem;
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-ink-600);
  }
  @media (min-width: 768px) {
    .lb-frame { padding: 1.5rem 2.5rem 2rem; }
    #lb-prev { left: -0.5rem; }
    #lb-next { right: -0.5rem; }
  }
</style>

<script define:vars={{ imgs }}>
  const dialog = document.getElementById('lightbox');
  if (dialog) {
    const lbImg = document.getElementById('lb-img');
    const lbCap = document.getElementById('lb-caption');
    const lbCount = document.getElementById('lb-counter');
    let current = 0;

    const show = (i) => {
      current = ((i % imgs.length) + imgs.length) % imgs.length;
      const img = imgs[current];
      lbImg.src = img.src;
      lbImg.alt = img.caption ?? '';
      lbCap.textContent = img.caption ?? '';
      lbCount.textContent = `${String(current + 1).padStart(2, '0')} / ${String(imgs.length).padStart(2, '0')}`;
    };

    document.querySelectorAll('.gallery-thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.index));
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
    dialog.addEventListener('close', () => { document.body.style.overflow = ''; });

    document.getElementById('lb-prev').addEventListener('click', () => show(current - 1));
    document.getElementById('lb-next').addEventListener('click', () => show(current + 1));
    document.getElementById('lb-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target.classList?.contains('lb-stage')) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
