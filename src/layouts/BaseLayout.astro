---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';

// Only the built site sends analytics, so `npm run dev` visits don't count.
const gtmId = import.meta.env.PROD ? site.gtmId : undefined;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Pass true to use title as-is (no "| Bruno Arq" suffix) */
  fullTitle?: boolean;
}

const {
  title,
  description = 'Arquiteto e urbanista em Belo Horizonte. Projetos residenciais, comerciais e design de interiores em BH e Minas Gerais.',
  ogImage = '/og-image.png',
  ogType = 'website',
  fullTitle = false,
} = Astro.props;

const siteUrl   = Astro.site ?? new URL('https://bruno.arq.br');
const pageUrl   = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = fullTitle ? title : `${title} | Bruno Arq`;
const absOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bruno Duarte de Oliveira',
  jobTitle: 'Arquiteto e Urbanista',
  url: siteUrl.toString(),
  sameAs: [
    'https://github.com/brunoduarto',
    'https://www.linkedin.com/in/bruno-duarte-deoliveira/',
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <!-- Primary -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bruno" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={absOgImage} />
    <meta property="og:locale"      content="pt_BR" />
    <meta property="og:site_name"   content="Bruno Arq" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={absOgImage} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- Mark JS as available before paint so [data-reveal] can start hidden -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- JSON-LD Person schema (identifies portfolio owner to search engines) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Slot for extra head tags from child layouts (e.g. Article schema on project pages) -->
    <slot name="head" />
  </head>
  <body class="bg-warm-50 text-ink-800 font-body font-light antialiased">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Reveal [data-reveal] elements as they scroll into view.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
