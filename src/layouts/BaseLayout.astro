---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site';

// Only the built site sends analytics, so `npm run dev` visits don't count.
const gtmId = import.meta.env.PROD ? site.gtmId : undefined;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Pass true to use title as-is (no "| Estúdio duarq" suffix) */
  fullTitle?: boolean;
}

const {
  title,
  description = 'Arquiteto e urbanista em Belo Horizonte. Projetos residenciais, comerciais e design de interiores em BH e Minas Gerais.',
  ogImage = '/og-image.png',
  ogType = 'website',
  fullTitle = false,
} = Astro.props;

const siteUrl   = Astro.site ?? new URL('https://bruno.arq.br');
const pageUrl   = new URL(Astro.url.pathname, siteUrl).toString();
const pageTitle = fullTitle ? title : `${title} | ${site.studio}`;
const absOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

// Structured data: the studio (ProfessionalService) and the architect (Person)
// as one linked entity, so Google ties the site, the CAU registration and the
// social profiles together. schema.org has no "Architect" type; this is the
// standard pairing for an architecture practice.
const home = siteUrl.toString();
const studioId = `${home}#estudio`;
const personId = `${home}#bruno`;
const telephone = `+${site.whatsapp.replace(/^(\d{2})(\d{2})(\d{5})(\d{4})$/, '$1 $2 $3-$4')}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': studioId,
      name: site.studio,
      description: 'Estúdio de arquitetura e interiores: projetos residenciais, comerciais, interiores e projeto executivo em Belo Horizonte e Minas Gerais.',
      url: home,
      logo: new URL('/logos/logo-duarq.svg', siteUrl).toString(),
      image: new URL('/og-image.png', siteUrl).toString(),
      email: site.email,
      telephone,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Belo Horizonte',
        addressRegion: 'MG',
        addressCountry: 'BR',
      },
      areaServed: [
        { '@type': 'City', name: 'Belo Horizonte' },
        { '@type': 'State', name: 'Minas Gerais' },
      ],
      knowsAbout: ['Arquitetura residencial', 'Arquitetura comercial', 'Design de interiores', 'Projeto executivo', 'BIM'],
      founder: { '@id': personId },
      sameAs: [site.instagram],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.fullName,
      alternateName: site.name,
      jobTitle: site.role,
      url: new URL('/about', siteUrl).toString(),
      image: new URL('/headshot_profissional.jpg', siteUrl).toString(),
      worksFor: { '@id': studioId },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Federal de Viçosa' },
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Registro profissional',
        name: `CAU ${site.cau}`,
        recognizedBy: {
          '@type': 'Organization',
          name: 'Conselho de Arquitetura e Urbanismo do Brasil',
          url: 'https://caubr.gov.br',
        },
      },
      sameAs: [site.linkedin, site.instagram, site.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#site`,
      url: home,
      name: site.studio,
      inLanguage: 'pt-BR',
      publisher: { '@id': studioId },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Consent Mode defaults: everything denied until the visitor accepts in the cookie banner.
         Must run before Tag Manager. A previous "Aceitar" is restored from localStorage. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      var duarqConsent = null;
      try { duarqConsent = localStorage.getItem('duarq-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: duarqConsent === 'granted' ? 'granted' : 'denied',
        wait_for_update: 500
      });
    </script>

    <!-- Google Tag Manager -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <!-- Primary -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Bruno" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={pageUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={absOgImage} />
    <meta property="og:locale"      content="pt_BR" />
    <meta property="og:site_name"   content={site.studio} />
    <meta name="theme-color" content="#141212" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={absOgImage} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,200..600;1,300..400&display=swap"
      rel="stylesheet"
    />

    <!-- Mark JS as available before paint so [data-reveal] can start hidden -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- JSON-LD: studio + architect as one entity for search engines -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Slot for extra head tags from child layouts (e.g. Article schema on project pages) -->
    <slot name="head" />
  </head>
  <body class="bg-warm-50 text-ink-800 font-body font-light antialiased">
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <CookieConsent />

    <script>
      // Reveal [data-reveal] elements as they scroll into view.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
