---
/*
  Full-bleed hero with crossfade between two images every 5 seconds.
*/
const slides = [
  { src: '/projects/casa-antonio-sabrina/7.png', alt: 'Design de interiores - sala contemporânea' },
  { src: '/hero-render-1.jpg', alt: 'Projeto urbanístico - espaço público' },
];
---

<section class="relative min-h-[85vh] flex items-end overflow-hidden">
  {/* Background images — stacked, crossfade via JS */}
  {slides.map((slide, i) => (
    <div
      class:list={['hero-slide absolute inset-0 -z-20 transition-opacity duration-1000', i === 0 ? 'opacity-100' : 'opacity-0']}
      data-slide-index={i}
    >
      <img
        src={slide.src}
        alt={slide.alt}
        class="w-full h-full object-cover"
      />
    </div>
  ))}

  {/* Gradient overlay */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950/80 via-ink-950/20 to-transparent"></div>

  {/* Content */}
  <div class="max-w-6xl mx-auto px-4 pb-16 md:pb-24 w-full">
    <p class="text-warm-300 text-sm font-medium tracking-widest uppercase mb-3">
      Arquitetura &amp; Design de Interiores
    </p>
    <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-white leading-tight max-w-3xl">
      Projetando espaços que transformam o seu dia a dia
    </h1>
    <p class="mt-6 text-lg text-warm-200/90 max-w-xl leading-relaxed">
      Projetos residenciais e comerciais em Belo Horizonte e Minas Gerais.
      Do conceito ao executivo, com atenção a cada detalhe.
    </p>

    <div class="flex flex-wrap gap-4 mt-8">
      <a
        href="/projects"
        class="inline-flex items-center px-7 py-3.5 bg-white text-ink-950 text-sm font-medium hover:bg-warm-100 transition-colors"
      >
        Ver Projetos
      </a>
      <a
        href="/contact"
        class="inline-flex items-center px-7 py-3.5 border border-white/30 text-white text-sm font-medium hover:bg-white/10 transition-colors"
      >
        Fale Comigo
      </a>
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  let current = 0;

  setInterval(() => {
    slides[current].classList.remove('opacity-100');
    slides[current].classList.add('opacity-0');
    current = (current + 1) % slides.length;
    slides[current].classList.remove('opacity-0');
    slides[current].classList.add('opacity-100');
  }, 5000);
</script>
