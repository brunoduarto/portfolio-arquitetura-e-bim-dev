---
import { navLinks } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && currentPath.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-warm-50/90 backdrop-blur-md border-b border-transparent transition-colors duration-300 data-scrolled:border-warm-200"
>
  <div class="max-w-7xl mx-auto px-5 md:px-10 flex items-center justify-between h-18 md:h-20">
    <a href="/" class="flex items-baseline gap-2 text-ink-950" aria-label="Bruno Duarte — início">
      <span class="font-display text-2xl leading-none">Bruno Duarte</span>
      <span class="eyebrow hidden sm:inline">Arquitetura</span>
    </a>

    <nav class="hidden lg:flex items-center gap-9" aria-label="Principal">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'text-[0.8rem] tracking-[0.12em] uppercase transition-colors',
            isActive(href) ? 'text-warm-700' : 'text-ink-600 hover:text-ink-950',
          ]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <a href="/quiz" class="btn btn-dark py-3 px-5">Iniciar projeto</a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden -mr-2 p-2 text-ink-900"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menu"
    >
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
        <path class="menu-open" d="M3 8h18M3 16h18" />
        <path class="menu-close hidden" d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>
  </div>

  {/* Mobile: full-screen menu */}
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-x-0 top-18 bottom-0 bg-warm-50 px-5 pt-10 pb-12 flex-col justify-between hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Principal (celular)">
      {navLinks.map(({ href, label }, i) => (
        <a href={href} class="flex items-baseline gap-4 py-3 border-b border-warm-200">
          <span class="index-num text-sm">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display text-4xl text-ink-950">{label}</span>
        </a>
      ))}
    </nav>
    <a href="/quiz" class="btn btn-dark w-full">Iniciar projeto</a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    toggle.querySelector('.menu-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')!.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
