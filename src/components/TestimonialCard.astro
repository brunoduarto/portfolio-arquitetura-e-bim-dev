---
interface Props {
  quote: string;
  name: string;
  role: string;
}

const { quote, name, role } = Astro.props;
---

<div class="bg-white border border-warm-200 p-8">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-warm-300 mb-4" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>
  <p class="text-ink-600 leading-relaxed mb-6 italic">"{quote}"</p>
  <div>
    <p class="font-medium text-ink-900">{name}</p>
    <p class="text-sm text-ink-400">{role}</p>
  </div>
</div>
