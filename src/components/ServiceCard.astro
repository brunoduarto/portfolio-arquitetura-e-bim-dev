---
interface Props {
  title: string;
  description: string;
  icon: string;
  href?: string;
}

const { title, description, icon, href = '/contact' } = Astro.props;
---

<a
  href={href}
  class="group block bg-white border border-warm-200 p-8 hover:border-warm-400 hover:shadow-lg transition-all"
>
  <div class="w-12 h-12 bg-warm-100 flex items-center justify-center mb-5 group-hover:bg-warm-200 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-warm-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
    </svg>
  </div>
  <h3 class="font-display text-xl text-ink-950 mb-3">{title}</h3>
  <p class="text-ink-500 text-sm leading-relaxed">{description}</p>
  <span class="inline-flex items-center gap-1 mt-4 text-sm text-warm-700 font-medium group-hover:gap-2 transition-all">
    Saiba mais
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
