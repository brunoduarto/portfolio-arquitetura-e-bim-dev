---
interface Props {
  title: string;
  description: string;
  slug: string;
  date: string;
  coverImage?: string;
  category?: string;
}

const { title, description, slug, date, coverImage, category } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('pt-BR', {
  month: 'short',
  year: 'numeric',
}).replace('.', '');
---

<a href={`/blog/${slug}`} class="group block">
  <div class="img-zoom aspect-[3/2] bg-warm-200 rounded-2xl">
    {coverImage && (
      <img src={coverImage} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
    )}
  </div>
  <p class="mt-5 eyebrow">
    {formattedDate}{category && <span class="text-warm-600"> · {category}</span>}
  </p>
  <h3 class="mt-2 font-display text-xl md:text-2xl font-normal leading-snug text-ink-950 group-hover:text-warm-700 transition-colors">
    {title}
  </h3>
  <p class="mt-3 text-ink-600 text-[0.95rem] leading-relaxed line-clamp-2">{description}</p>
</a>
