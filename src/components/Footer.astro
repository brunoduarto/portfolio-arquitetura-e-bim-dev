---
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink-950 text-ink-300">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid md:grid-cols-3 gap-12">
      {/* Brand */}
      <div>
        <a href="/" class="font-display text-xl text-warm-50">
          bruno<span class="text-warm-500">.arq</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-ink-400">
          Arquitetura residencial, comercial e design de interiores
          em Belo Horizonte e Minas Gerais.
        </p>
      </div>

      {/* Links */}
      <div>
        <h3 class="text-sm font-medium text-ink-200 uppercase tracking-wider mb-4">Navegação</h3>
        <ul class="space-y-2">
          <li><a href="/projects" class="text-sm hover:text-warm-400 transition-colors">Projetos</a></li>
          <li><a href="/about" class="text-sm hover:text-warm-400 transition-colors">Sobre</a></li>
          <li><a href="/blog" class="text-sm hover:text-warm-400 transition-colors">Blog</a></li>
          <li><a href="/contact" class="text-sm hover:text-warm-400 transition-colors">Contato</a></li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h3 class="text-sm font-medium text-ink-200 uppercase tracking-wider mb-4">Contato</h3>
        <ul class="space-y-2">
          <li><a href="mailto:contato@bruno.arq.br" class="text-sm hover:text-warm-400 transition-colors">contato@bruno.arq.br</a></li>
          <li><a href="https://www.linkedin.com/in/bruno-duarte-deoliveira/" target="_blank" rel="noopener noreferrer" class="text-sm hover:text-warm-400 transition-colors">LinkedIn</a></li>
          <li><a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="text-sm hover:text-warm-400 transition-colors">Instagram</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-ink-800 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <span>&copy; {currentYear} Bruno Duarte — Arquiteto e Urbanista. Todos os direitos reservados.</span>
      <span>Belo Horizonte, MG</span>
    </div>
  </div>
</footer>
