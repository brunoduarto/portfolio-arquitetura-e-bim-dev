---
// "Sobre" section with Google reviews. Content comes from src/data/reviews.ts.
import { site } from '../data/site';
import { reviews, reviewsAreReal, googleSummary } from '../data/reviews';

const isSample = !reviewsAreReal;
const stars = (n: number) => Array.from({ length: 5 }, (_, i) => i < n);
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
---

<section class="border-t border-warm-300">
  <div class="max-w-7xl mx-auto px-5 md:px-10 py-20 md:py-28">
    {isSample && (
      <p class="mb-8 inline-block border border-warm-500 px-3 py-1.5 text-xs text-warm-700">
        Amostra — só aparece no <code>npm run dev</code>. Coloque avaliações reais em src/data/reviews.ts.
      </p>
    )}

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Sobre</p>
        <h2 class="mt-5 font-display text-4xl md:text-5xl leading-[1.08] text-ink-950">
          O que dizem <em>os clientes</em>
        </h2>
        <div class="mt-8 flex items-center gap-4">
          <svg class="w-9 h-9 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
            <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
          </svg>
          <div>
            <p class="flex items-baseline gap-2 text-ink-950">
              <span class="text-3xl font-light">{googleSummary.rating.toFixed(1).replace('.', ',')}</span>
              <span class="flex text-[#FBBC04]" aria-label={`${googleSummary.rating} de 5 estrelas`}>
                {stars(Math.round(googleSummary.rating)).map((on) => <span class:list={[!on && 'text-ink-300']}>★</span>)}
              </span>
            </p>
            <p class="text-sm text-ink-500">
              Avaliações no Google{googleSummary.total > 0 && ` · ${googleSummary.total}`}
            </p>
          </div>
        </div>
        <p class="mt-8 text-ink-600 leading-relaxed max-w-sm">
          {site.name} — arquiteto e urbanista em Belo Horizonte, com experiência em projetos
          residenciais, comerciais, reformas e modelagem BIM.
        </p>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/about" class="link-line">Mais sobre mim</a>
          {googleSummary.profileUrl && (
            <a href={googleSummary.profileUrl} target="_blank" rel="noopener noreferrer" class="link-line">Ver no Google</a>
          )}
        </div>
      </div>

      <ul class="lg:col-span-8 grid md:grid-cols-2 gap-5">
        {reviews.map((r, i) => (
          <li class:list={['bg-warm-100 border border-warm-300 p-6 md:p-7 flex flex-col', i === 0 && 'md:col-span-2']} data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-full bg-warm-800 text-white text-sm font-medium flex items-center justify-center" aria-hidden="true">
                {initials(r.name)}
              </span>
              <div class="min-w-0">
                <p class="text-ink-950 truncate">{r.name}</p>
                <p class="text-xs text-ink-500">{r.date}</p>
              </div>
              <svg class="ml-auto w-5 h-5 shrink-0 opacity-80" viewBox="0 0 48 48" aria-label="Google">
                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
              </svg>
            </div>
            <p class="mt-4 flex text-[#FBBC04]" aria-label={`${r.rating} de 5 estrelas`}>
              {stars(r.rating).map((on) => <span class:list={[!on && 'text-ink-300']}>★</span>)}
            </p>
            <p class:list={['mt-3 text-ink-700 leading-relaxed', i === 0 && 'md:text-lg']}>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
